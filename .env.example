OPENAI_API_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# 새 형식 secret 키(sb_secret_...). RLS를 우회하므로 서버에만 둔다
SUPABASE_SECRET_KEY=
# drizzle-kit 전용 Postgres 연결 문자열(Supabase Connect → Session pooler). 로컬에만 두고 Vercel에는 넣지 않는다
DATABASE_URL=

# 이력서랍 텔레그램 봇 (운영 봇과 개발 봇을 따로 만든다)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 32~256자, A-Z a-z 0-9 _ - 만 허용 (예: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# 32자 이상. Supabase Vault의 drawer_cron_secret과 같은 값
CRON_SECRET=
# 끝에 / 없이. 텔레그램 webhook과 딥링크 안내에 쓰임
APP_URL=http://localhost:5173

# E2E 테스트용 계정 (본인 계정과 별개)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# 데모 모드 강제 (실제 DB·OpenAI·텔레그램 없이 화면 확인). 운영 배포에서는 거부됨.
# 위 값이 비어 있으면 로컬·프리뷰는 자동으로 데모 모드가 됨
# DEMO_MODE=1

# E2E 테스트에서만 사용. 프로덕션에서는 설정하면 안 됨
# E2E_FAKE_LLM=1
# E2E_FAKE_TELEGRAM_OUTBOX=test-results/telegram-outbox.jsonl
# 설치된 브라우저가 Playwright 버전과 다를 때만
# PLAYWRIGHT_CHROMIUM_PATH=
